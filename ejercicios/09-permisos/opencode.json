{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*src/test/*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ]
}
